      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isOfficer}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0k53vew" sourceRef="Gateway_1b4zwse" targetRef="Activity_0f2jb7q">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!isOfficer}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1hdww6l" sourceRef="Activity_0f2jb7q" targetRef="Gateway_1cvdekx" />
    <bpmn:sequenceFlow id="Flow_1i310ex" sourceRef="Activity_1c4c8zz" targetRef="Gateway_1cvdekx" />
    <bpmn:serviceTask id="Activity_0f2jb7q" name="Пошук громадян за введеними атрибутами" camunda:modelerTemplate="searchRegistryUsersByRoleAndAttributes" camunda:delegateExpression="${searchRegistryUsersByRoleAndAttributes}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="status" />
          <camunda:inputParameter name="username" />
          <camunda:inputParameter name="role_name" />
          <camunda:inputParameter name="attributesEquals">${attributesEquals}</camunda:inputParameter>
          <camunda:inputParameter name="attributesStartWith">${attributesStartsWith}</camunda:inputParameter>
          <camunda:inputParameter name="attributesThatAreStartFor">${attributesInverseStartsWith}</camunda:inputParameter>
          <camunda:inputParameter name="limit">100</camunda:inputParameter>
          <camunda:inputParameter name="offset" />
          <camunda:inputParameter name="realm">citizen</camunda:inputParameter>
          <camunda:outputParameter name="usersResponse">${ usersResponse }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k53vew</bpmn:incoming>
      <bpmn:outgoing>Flow_1hdww6l</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1c4c8zz" name="Пошук чиновників за введеними атрибутами" camunda:modelerTemplate="searchRegistryUsersByRoleAndAttributes" camunda:delegateExpression="${searchRegistryUsersByRoleAndAttributes}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="status" />
          <camunda:inputParameter name="username" />
          <camunda:inputParameter name="role_name" />
          <camunda:inputParameter name="attributesEquals">${attributesEquals}</camunda:inputParameter>
          <camunda:inputParameter name="attributesStartWith">${attributesStartsWith}</camunda:inputParameter>
          <camunda:inputParameter name="attributesThatAreStartFor">${attributesInverseStartsWith}</camunda:inputParameter>
          <camunda:inputParameter name="limit">100</camunda:inputParameter>
          <camunda:inputParameter name="offset" />
          <camunda:inputParameter name="realm">officer</camunda:inputParameter>
          <camunda:outputParameter name="usersResponse">${ usersResponse }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05lvq69</bpmn:incoming>
      <bpmn:outgoing>Flow_1i310ex</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_08bdhqu" name="Підготувати дані для відображення" scriptFormat="groovy">
      <bpmn:incoming>Flow_1njgeyk</bpmn:incoming>
      <bpmn:outgoing>Flow_0x7dmev</bpmn:outgoing>
      <bpmn:script>println  "usersByAttributes " +  usersResponse

        def users = usersResponse.users.stream().map(o -&gt; ['fullName': o.fullName, 'edrpou': o.attributes['edrpou'], 'drfo': o.attributes['drfo']]).collect()

        def formData = [
        'users': users
        ]

        set_variable('usersFormData', formData)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_1omyois" name="end">
      <bpmn:incoming>Flow_0x7dmev</bpmn:incoming>
    </bpmn:endEvent>
